# Endereço da barbearia-api, terminando em /api.
# - Emulador Android: http://10.0.2.2:3000/api
# - Simulador iOS: http://localhost:3000/api
# - Celular físico: http://<IP do computador na rede>:3000/api
#   (no WSL2, ative o "networking mode = mirrored" ou use um túnel como `npx localtunnel --port 3000`)
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api

# Login com Google (Google Cloud Console → APIs e serviços → Credenciais).
# ID do cliente do tipo WEB: é para ele que o Google emite o idToken que a API confere.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# ID do cliente do tipo iOS.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# "Esquema de URL do iOS" do mesmo cliente iOS (com.googleusercontent.apps....). Lido no app.config.ts.
GOOGLE_IOS_URL_SCHEME=
